<script>
  (function() {
    function initShopByLook(sectionEl) {
      if (!sectionEl) return;
      if (sectionEl.dataset.initialized === 'true') return;
      sectionEl.dataset.initialized = 'true';

      const sectionId = sectionEl.dataset.sectionId;
      const tabs = Array.from(sectionEl.querySelectorAll('.sbl-tab-btn'));
      const cards = Array.from(sectionEl.querySelectorAll('.sbl-card'));
      const emptyState = sectionEl.querySelector('#SBLEmpty-' + sectionId);

      // Category Filter Function
      function filterCategory(category) {
        const target = (category || '').toLowerCase().trim();
        let visibleCount = 0;
        cards.forEach(card => {
          const cardCat = (card.dataset.category || '').toLowerCase().trim();
          const match = cardCat === target;
          card.classList.toggle('is-hidden', !match);
          if (match) visibleCount++;
        });

        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }

      // Tab Activate Function
      function activateTab(tab) {
        if (!tab) return;
        tabs.forEach(t => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        const cat = tab.dataset.category;
        filterCategory(cat);
      }

      // Tab Click Listeners
      tabs.forEach(tab => {
        tab.addEventListener('click', (e) => {
          e.preventDefault();
          activateTab(tab);
        });
      });

      // Filter to initial active tab on page load
      const initialTab = sectionEl.querySelector('.sbl-tab-btn.is-active') || tabs[0];
      if (initialTab) {
        activateTab(initialTab);
      }

      // -----------------------------------------------------------------------
      // Modal Management & Teleportation to document.body
      // -----------------------------------------------------------------------
      const modalRoot = sectionEl.querySelector('.sbl-modal-root');
      if (modalRoot) {
        // Remove duplicate stale modal root if re-rendered by Shopify Theme Editor
        const existingRoot = document.getElementById('SBLModalRoot-' + sectionId);
        if (existingRoot && existingRoot !== modalRoot && existingRoot.parentNode) {
          existingRoot.parentNode.removeChild(existingRoot);
        }
        // Teleport modalRoot directly into document.body so it is NEVER trapped
        // by any Shopify section's stacking context, transform, or z-index!
        if (modalRoot.parentNode !== document.body) {
          document.body.appendChild(modalRoot);
        }
      }

      function openModal(modalId) {
        const modal = document.getElementById(modalId);
        if (!modal) return;
        modal.classList.add('is-active');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        document.documentElement.style.overflow = 'hidden';
      }

      function closeModal(modal) {
        if (!modal) return;
        modal.classList.remove('is-active');
        modal.setAttribute('aria-hidden', 'true');
        // Only restore scroll if size chart isn't open
        const rootContainer = modalRoot || document;
        const scModal = rootContainer.querySelector('.sbl-sizechart-modal.is-active');
        if (!scModal) {
          document.body.style.overflow = '';
          document.documentElement.style.overflow = '';
        }
      }

      // Listen for Modal Open Triggers on Section Cards
      sectionEl.addEventListener('click', (e) => {
        const trigger = e.target.closest('[data-open-modal]');
        if (trigger) {
          e.preventDefault();
          e.stopPropagation();
          const targetId = trigger.dataset.openModal;
          if (targetId) openModal(targetId);
        }
      });

      // Listen for Modal Close Triggers on modalRoot (Close Button & Backdrop)
      if (modalRoot) {
        modalRoot.addEventListener('click', (e) => {
          const closeBtn = e.target.closest('[data-close-modal]');
          if (closeBtn) {
            e.preventDefault();
            const modal = closeBtn.closest('.sbl-modal');
            if (modal) closeModal(modal);
          }
        });
      }

      // =======================================================================
      // Size Chart Modal Management
      // =======================================================================
      const sizeChartModal = (modalRoot || sectionEl).querySelector('.sbl-sizechart-modal');
      if (sizeChartModal) {
        const scTabs = Array.from(sizeChartModal.querySelectorAll('.sbl-sc-tab-btn'));
        const scUnitBtns = Array.from(sizeChartModal.querySelectorAll('.sbl-sc-unit-btn'));
        const scShirtPanel = sizeChartModal.querySelector('.sbl-sc-panel[data-panel="shirt"]');
        const scPantPanel = sizeChartModal.querySelector('.sbl-sc-panel[data-panel="pant"]');
        const scTitle = sizeChartModal.querySelector('.sbl-sc-title');
        const scSubtitle = sizeChartModal.querySelector('.sbl-sc-subtitle');
        const scCustomWrap = sizeChartModal.querySelector('.sbl-sc-custom-img-wrap');
        const scCustomImg = sizeChartModal.querySelector('.sbl-sc-custom-img');

        function switchSizeChartType(type, customImgUrl) {
          scTabs.forEach(t => {
            const match = t.dataset.type === type;
            t.classList.toggle('is-active', match);
          });

          if (scShirtPanel) scShirtPanel.style.display = type === 'shirt' ? 'block' : 'none';
          if (scPantPanel) scPantPanel.style.display = type === 'pant' ? 'block' : 'none';

          if (scTitle) {
            scTitle.textContent = type === 'shirt' ? "MEN'S SLIM FIT SHIRT SIZE CHART" : "FORMAL TROUSER SIZE CHART";
          }
          if (scSubtitle) {
            const activeUnit = sizeChartModal.querySelector('.sbl-sc-unit-btn.is-active');
            const unitText = (activeUnit && activeUnit.dataset.unit === 'cm') ? 'All measurements are in centimeters.' : 'All measurements are in inches.';
            scSubtitle.textContent = unitText;
          }

          // Custom image display
          const fallbackGlobal = type === 'shirt' ? sectionEl.dataset.globalShirtChart : sectionEl.dataset.globalPantChart;
          const finalImg = customImgUrl || fallbackGlobal || '';
          if (scCustomWrap && scCustomImg) {
            if (finalImg) {
              scCustomImg.src = finalImg;
              scCustomWrap.style.display = 'block';
            } else {
              scCustomWrap.style.display = 'none';
            }
          }
        }

        function setSizeChartUnit(unit) {
          scUnitBtns.forEach(b => b.classList.toggle('is-active', b.dataset.unit === unit));
          sizeChartModal.querySelectorAll('[data-unit-in]').forEach(el => {
            el.style.display = unit === 'in' ? '' : 'none';
          });
          sizeChartModal.querySelectorAll('[data-unit-cm]').forEach(el => {
            el.style.display = unit === 'cm' ? '' : 'none';
          });
          if (scSubtitle) {
            scSubtitle.textContent = unit === 'cm' ? 'All measurements are in centimeters.' : 'All measurements are in inches.';
          }
        }

        function openSizeChart(type, customImgUrl) {
          // If the product page has an existing theme modal dialog (e.g. #PopupModal-size-chart), check for it
          const themeModal = document.querySelector('modal-dialog[id*="size-chart"], modal-dialog[id*="PopupModal"]');
          if (themeModal && typeof themeModal.show === 'function') {
            try {
              themeModal.show();
              return;
            } catch (err) {}
          }

          // Open built-in high-definition size chart modal
          switchSizeChartType(type, customImgUrl);
          sizeChartModal.classList.add('is-active');
          sizeChartModal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
          document.documentElement.style.overflow = 'hidden';
        }

        function closeSizeChart() {
          sizeChartModal.classList.remove('is-active');
          sizeChartModal.setAttribute('aria-hidden', 'true');
          const rootContainer = modalRoot || document;
          const activeLookModal = rootContainer.querySelector('.sbl-modal.is-active');
          if (!activeLookModal) {
            document.body.style.overflow = '';
            document.documentElement.style.overflow = '';
          }
        }

        scTabs.forEach(tab => {
          tab.addEventListener('click', (e) => {
            e.preventDefault();
            switchSizeChartType(tab.dataset.type);
          });
        });

        scUnitBtns.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            setSizeChartUnit(btn.dataset.unit);
          });
        });

        // Trigger Listeners on modalRoot and sectionEl
        const eventTargets = modalRoot ? [sectionEl, modalRoot] : [sectionEl];
        eventTargets.forEach(target => {
          target.addEventListener('click', (e) => {
            const scTrigger = e.target.closest('[data-open-size-chart]');
            if (scTrigger) {
              e.preventDefault();
              e.stopPropagation();
              const type = scTrigger.dataset.openSizeChart || 'shirt';
              const customImg = scTrigger.dataset.customImage || '';
              openSizeChart(type, customImg);
            }

            const scCloseBtn = e.target.closest('[data-close-size-chart]');
            if (scCloseBtn) {
              e.preventDefault();
              closeSizeChart();
            }
          });
        });
      }

      // Escape key to close any active modal
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const rootContainer = modalRoot || document;
          const activeSC = rootContainer.querySelector('.sbl-sizechart-modal.is-active');
          if (activeSC) {
            activeSC.classList.remove('is-active');
            activeSC.setAttribute('aria-hidden', 'true');
            return;
          }
          const activeModal = rootContainer.querySelector('.sbl-modal.is-active');
          if (activeModal) closeModal(activeModal);
        }
      });

      // Setup All Modals (Galleries, Sizes, Quantity, Cart Add)
      (modalRoot || sectionEl).querySelectorAll('.sbl-modal').forEach(modal => {
        // 1. Gallery Carousel
        const slides = Array.from(modal.querySelectorAll('.sbl-slide'));
        const thumbs = Array.from(modal.querySelectorAll('.sbl-thumb-btn'));
        const prevArrow = modal.querySelector('.sbl-gallery-arrow--prev');
        const nextArrow = modal.querySelector('.sbl-gallery-arrow--next');
        const stage = modal.querySelector('.sbl-gallery-stage');
        let currentSlide = 0;

        function setSlide(idx) {
          if (slides.length <= 1) return;
          if (idx < 0) idx = slides.length - 1;
          if (idx >= slides.length) idx = 0;
          currentSlide = idx;

          slides.forEach((s, i) => s.classList.toggle('is-active', i === currentSlide));
          thumbs.forEach((t, i) => t.classList.toggle('is-active', i === currentSlide));
        }

        if (prevArrow) {
          prevArrow.addEventListener('click', (e) => {
            e.stopPropagation();
            setSlide(currentSlide - 1);
          });
        }
        if (nextArrow) {
          nextArrow.addEventListener('click', (e) => {
            e.stopPropagation();
            setSlide(currentSlide + 1);
          });
        }

        thumbs.forEach((thumb, tIdx) => {
          thumb.addEventListener('click', (e) => {
            e.stopPropagation();
            setSlide(tIdx);
          });
        });

        // Touch Swipe on Modal Gallery
        if (stage) {
          let touchStartX = 0;
          let touchStartY = 0;

          stage.addEventListener('touchstart', (e) => {
            if (!e.changedTouches || e.changedTouches.length === 0) return;
            touchStartX = e.changedTouches[0].clientX;
            touchStartY = e.changedTouches[0].clientY;
          }, { passive: true });

          stage.addEventListener('touchend', (e) => {
            if (!e.changedTouches || e.changedTouches.length === 0) return;
            const diffX = touchStartX - e.changedTouches[0].clientX;
            const diffY = touchStartY - e.changedTouches[0].clientY;

            if (Math.abs(diffX) > 30 && Math.abs(diffX) > Math.abs(diffY)) {
              if (diffX > 0) setSlide(currentSlide + 1);
              else setSlide(currentSlide - 1);
            }
          }, { passive: true });
        }

        // 2. Size Pill Selectors (Shirt & Pant)
        modal.querySelectorAll('.sbl-piece-box').forEach(box => {
          const pills = Array.from(box.querySelectorAll('.sbl-size-pill'));
          pills.forEach(pill => {
            pill.addEventListener('click', () => {
              pills.forEach(p => p.classList.remove('is-selected'));
              pill.classList.add('is-selected');
            });
          });
        });

        // 3. Quantity Controls
        const minusBtn = modal.querySelector('.sbl-qty-btn--minus');
        const plusBtn = modal.querySelector('.sbl-qty-btn--plus');
        const qtyInput = modal.querySelector('.sbl-qty-input');

        if (minusBtn && qtyInput) {
          minusBtn.addEventListener('click', () => {
            let val = parseInt(qtyInput.value, 10) || 1;
            if (val > 1) qtyInput.value = val - 1;
          });
        }
        if (plusBtn && qtyInput) {
          plusBtn.addEventListener('click', () => {
            let val = parseInt(qtyInput.value, 10) || 1;
            qtyInput.value = val + 1;
          });
        }

        // 4. Batch Add to Cart & Buy It Now
        async function getBundleVariantsAndQty() {
          const shirtPill = modal.querySelector('.sbl-piece-box[data-piece="shirt"] .sbl-size-pill.is-selected');
          const pantPill = modal.querySelector('.sbl-piece-box[data-piece="pant"] .sbl-size-pill.is-selected');
          const qty = parseInt(qtyInput ? qtyInput.value : 1, 10) || 1;

          const shirtVarId = shirtPill ? shirtPill.dataset.variantId : null;
          const pantVarId = pantPill ? pantPill.dataset.variantId : null;
          const lookTitle = modal.querySelector('.sbl-modal-title') ? modal.querySelector('.sbl-modal-title').textContent.trim() : 'Look';

          return { shirtVarId, pantVarId, qty, lookTitle };
        }

        const addBtn = modal.querySelector('[data-add-to-cart]');
        if (addBtn) {
          addBtn.addEventListener('click', async (e) => {
            e.preventDefault();
            const { shirtVarId, pantVarId, qty, lookTitle } = await getBundleVariantsAndQty();

            const itemsToAdd = [];
            if (shirtVarId && !shirtVarId.startsWith('demo-')) {
              itemsToAdd.push({ id: parseInt(shirtVarId, 10), quantity: qty, properties: { '_bundle': lookTitle, 'Item': 'Shirt' } });
            }
            if (pantVarId && !pantVarId.startsWith('demo-')) {
              itemsToAdd.push({ id: parseInt(pantVarId, 10), quantity: qty, properties: { '_bundle': lookTitle, 'Item': 'Pant' } });
            }

            const btnText = addBtn.querySelector('span');
            const originalText = btnText ? btnText.textContent : 'ADD TO CART';
            if (btnText) btnText.textContent = 'Adding...';

            try {
              if (itemsToAdd.length > 0) {
                 const root = window.Shopify ? window.Shopify.routes.root : '/';
                 const res = await fetch(root + 'cart/add.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ items: itemsToAdd })
                });

                if (!res.ok) throw new Error('Cart add failed');
              }

              if (btnText) btnText.textContent = '✓ Added to Cart!';
              setTimeout(() => {
                closeModal(modal);
                if (btnText) btnText.textContent = originalText;
                document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
                document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
                const cartDrawer = document.querySelector('cart-drawer, #cart-drawer, #duch-cart-drawer');
                if (cartDrawer && typeof cartDrawer.open === 'function') cartDrawer.open();
                else if (cartDrawer && cartDrawer.classList) cartDrawer.classList.add('is-open', 'active');
              }, 600);
            } catch (err) {
              console.error(err);
              if (btnText) btnText.textContent = 'Added!';
              setTimeout(() => {
                closeModal(modal);
                if (btnText) btnText.textContent = originalText;
              }, 700);
            }
          });
        }

        const buyNowBtn = modal.querySelector('[data-buy-it-now]');
        if (buyNowBtn) {
          buyNowBtn.addEventListener('click', async (e) => {
            e.preventDefault();
            const { shirtVarId, pantVarId, qty, lookTitle } = await getBundleVariantsAndQty();

            const itemsToAdd = [];
            if (shirtVarId && !shirtVarId.startsWith('demo-')) {
              itemsToAdd.push({ id: parseInt(shirtVarId, 10), quantity: qty, properties: { '_bundle': lookTitle } });
            }
            if (pantVarId && !pantVarId.startsWith('demo-')) {
              itemsToAdd.push({ id: parseInt(pantVarId, 10), quantity: qty, properties: { '_bundle': lookTitle } });
            }

            buyNowBtn.textContent = 'Processing...';

            try {
              if (itemsToAdd.length > 0) {
                const root = window.Shopify ? window.Shopify.routes.root : '/';
                await fetch(root + 'cart/add.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ items: itemsToAdd })
                });
              }
              window.location.href = '/checkout';
            } catch (err) {
              window.location.href = '/checkout';
            }
          });
        }
      });
    }

    // Auto-init on DOM Ready
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.shop-by-look-section').forEach(initShopByLook);
    });

    if (document.readyState === 'interactive' || document.readyState === 'complete') {
      document.querySelectorAll('.shop-by-look-section').forEach(initShopByLook);
    }

    // Shopify Theme Editor Events
    document.addEventListener('shopify:section:unload', (e) => {
        if (e.detail && e.detail.sectionId === sectionId) {
          if (modalRoot && modalRoot.parentNode) {
            modalRoot.parentNode.removeChild(modalRoot);
          }
        }
      });

      document.addEventListener('shopify:section:load', (e) => {
      const section = e.target.querySelector('.shop-by-look-section') || (e.target.classList && e.target.classList.contains('shop-by-look-section') ? e.target : null);
      if (section) {
        section.dataset.initialized = 'false';
        initShopByLook(section);
      }
    });

    document.addEventListener('shopify:block:select', (e) => {
      const blockId = e.detail.blockId;
      const card = document.querySelector(`.sbl-card[data-block-id="${blockId}"]`);
      if (card) {
        const cat = card.dataset.category;
        const section = card.closest('.shop-by-look-section');
        if (section) {
          const tab = section.querySelector(`.sbl-tab-btn[data-category="${cat}"]`);
          if (tab) {
            tab.click();
          }
          setTimeout(() => {
            card.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }, 100);
        }
      }
    });
  })();
</script>

