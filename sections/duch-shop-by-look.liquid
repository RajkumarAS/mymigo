      {%- endif -%}
    </div>

    <div class="sbl-empty-state" id="SBLEmpty-{{ section_id }}">
      <p>No looks currently available in this category.</p>
    </div>
  </div>

  {%- comment -%} Modals Container {%- endcomment -%}
  <div class="sbl-modal-root" id="SBLModalRoot-{{ section_id }}">
    {%- comment -%} 1. Modals for User Configured Blocks {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          if block.settings.title != blank
            assign look_title = block.settings.title
          else
            assign look_title = 'Look ' | append: forloop.index
          endif
          assign shirt_prod = block.settings.shirt_product
          assign pant_prod = block.settings.pant_product
          assign s_price = shirt_prod.price | default: 139900
          assign p_price = pant_prod.price | default: 139900
          assign raw_compare = s_price | plus: p_price
          assign calc_price = raw_compare | minus: 40000

          if block.settings.custom_price != blank
            assign display_price = block.settings.custom_price | times: 100
          else
            assign display_price = calc_price
          endif

          if block.settings.custom_compare_price != blank
            assign display_compare = block.settings.custom_compare_price | times: 100
          else
            assign display_compare = raw_compare
          endif

          assign discount_badge = block.settings.discount_badge | default: 'SAVE ₹400'

          # Custom size chart images per block
          assign b_shirt_chart = ''
          if block.settings.shirt_size_chart != blank
            assign b_shirt_chart = block.settings.shirt_size_chart | image_url: width: 1200
          endif

          assign b_pant_chart = ''
          if block.settings.pant_size_chart != blank
            assign b_pant_chart = block.settings.pant_size_chart | image_url: width: 1200
          endif
        -%}

        <div id="SBLModal-{{ section_id }}-{{ block.id }}" class="sbl-modal" aria-hidden="true">
          <div class="sbl-modal-backdrop" data-close-modal></div>
          <div class="sbl-modal-dialog">
            <button type="button" class="sbl-modal-close" data-close-modal aria-label="Close preview">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>

            <div class="sbl-modal-grid">
              {%- comment -%} 6-Photo Carousel Left Column {%- endcomment -%}
              <div class="sbl-gallery-wrap">
                <div class="sbl-gallery-stage">
                  {%- comment -%} Slide 1: Main Look {%- endcomment -%}
                  <div class="sbl-slide is-active" data-slide-index="0">
                    {%- if block.settings.look_image != blank -%}
                      <img src="{{ block.settings.look_image | image_url: width: 800 }}" alt="{{ look_title }}" class="sbl-slide-img">
                    {%- elsif shirt_prod.featured_image != blank -%}
                      <img src="{{ shirt_prod.featured_image | image_url: width: 800 }}" alt="{{ look_title }}" class="sbl-slide-img">
                    {%- else -%}
                      {%- case block.settings.category -%}
                        {%- when 'vacation' -%}
                          <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=800&q=80" alt="{{ look_title }}" class="sbl-slide-img">
                        {%- when 'party' -%}
                          <img src="https://images.unsplash.com/photo-1496345875659-11f7dd282d1d?auto=format&fit=crop&w=800&q=80" alt="{{ look_title }}" class="sbl-slide-img">
                        {%- when 'casuals' -%}
                          <img src="https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?auto=format&fit=crop&w=800&q=80" alt="{{ look_title }}" class="sbl-slide-img">
                        {%- else -%}
                          <img src="https://images.unsplash.com/photo-1617137984095-74e4e5e3613f?auto=format&fit=crop&w=800&q=80" alt="{{ look_title }}" class="sbl-slide-img">
                      {%- endcase -%}
                    {%- endif -%}
                  </div>

                  {%- comment -%} Slides 2 to 6 {%- endcomment -%}
                  {%- for g in (1..5) -%}
                    {%- assign g_key = 'gallery_image_' | append: g -%}
                    {%- assign g_img = block.settings[g_key] -%}
                    <div class="sbl-slide" data-slide-index="{{ g }}">
                      {%- if g_img != blank -%}
                        <img src="{{ g_img | image_url: width: 800 }}" alt="{{ look_title }}" class="sbl-slide-img">
                      {%- elsif pant_prod.images[g] != blank -%}
                        <img src="{{ pant_prod.images[g] | image_url: width: 800 }}" alt="{{ look_title }}" class="sbl-slide-img">
                      {%- elsif shirt_prod.images[g] != blank -%}
                        <img src="{{ shirt_prod.images[g] | image_url: width: 800 }}" alt="{{ look_title }}" class="sbl-slide-img">
                      {%- elsif block.settings.look_image != blank -%}
                        <img src="{{ block.settings.look_image | image_url: width: 800 }}" alt="{{ look_title }}" class="sbl-slide-img">
                      {%- else -%}
                        <img src="https://images.unsplash.com/photo-1617137984095-74e4e5e3613f?auto=format&fit=crop&w=800&q=80" alt="{{ look_title }}" class="sbl-slide-img">
                      {%- endif -%}
                    </div>
                  {%- endfor -%}

                  <button type="button" class="sbl-gallery-arrow sbl-gallery-arrow--prev" aria-label="Previous image">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                  </button>
                  <button type="button" class="sbl-gallery-arrow sbl-gallery-arrow--next" aria-label="Next image">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                  </button>
                </div>

                {%- comment -%} 6 Thumbnails Bar {%- endcomment -%}
                <div class="sbl-gallery-thumbs">
                  {%- assign thumb_main = block.settings.look_image | default: shirt_prod.featured_image -%}
                  <button type="button" class="sbl-thumb-btn is-active" data-thumb-index="0">
                    {%- if thumb_main != blank -%}
                      <img src="{{ thumb_main | image_url: width: 120 }}" class="sbl-thumb-img" alt="">
                    {%- else -%}
                      <img src="https://images.unsplash.com/photo-1617137984095-74e4e5e3613f?auto=format&fit=crop&w=120&q=80" class="sbl-thumb-img" alt="">
                    {%- endif -%}
                  </button>
                  {%- for g in (1..5) -%}
                    {%- assign g_key = 'gallery_image_' | append: g -%}
                    {%- assign g_img = block.settings[g_key] | default: shirt_prod.images[g] | default: pant_prod.images[g] | default: thumb_main -%}
                    <button type="button" class="sbl-thumb-btn" data-thumb-index="{{ g }}">
                      {%- if g_img != blank -%}
                        <img src="{{ g_img | image_url: width: 120 }}" class="sbl-thumb-img" alt="">
                      {%- else -%}
                        <img src="https://images.unsplash.com/photo-1617137984095-74e4e5e3613f?auto=format&fit=crop&w=120&q=80" class="sbl-thumb-img" alt="">
                      {%- endif -%}
                    </button>
                  {%- endfor -%}
                </div>
              </div>

              {%- comment -%} Product Controls Right Column {%- endcomment -%}
              <div class="sbl-details-wrap">
                <span class="sbl-modal-badge">{{ block.settings.category | upcase }} • 2-PIECE LOOK</span>
                <h2 class="sbl-modal-title">{{ look_title }}</h2>

                <div class="sbl-modal-pricing">
                  <span class="sbl-modal-price">{{ display_price | money }}</span>
                  <span class="sbl-modal-compare">{{ display_compare | money }}</span>
                  <span class="sbl-modal-save">{{ discount_badge }}</span>
                </div>

                <div class="sbl-discount-banner">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  <span><strong>{{ discount_badge }} applied</strong> automatically + FREE Shipping!</span>
                </div>

                {%- comment -%} 1. Shirt Size Selector {%- endcomment -%}
                <div class="sbl-piece-box" data-piece="shirt">
                  <div class="sbl-piece-header">
                    <span class="sbl-piece-name">1. Shirt Size</span>
                    <button
                      type="button"
                      class="sbl-size-chart-link"
                      data-open-size-chart="shirt"
                      data-custom-image="{{ b_shirt_chart }}"
                    >Size chart</button>
                  </div>
                  <div class="sbl-size-pills">
                    {%- if shirt_prod.variants.size > 0 and shirt_prod.has_only_default_variant == false -%}
                      {%- for variant in shirt_prod.variants -%}
                        {%- assign v_label = variant.option2 | default: variant.option1 | default: variant.title -%}
                        <button
                          type="button"
                          class="sbl-size-pill {% if forloop.first %}is-selected{% endif %} {% if variant.available == false %}is-sold-out{% endif %}"
                          data-variant-id="{{ variant.id }}"
                          data-variant-title="{{ variant.title }}"
                          {% if variant.available == false %}disabled{% endif %}
                        >{{ v_label }}</button>
                      {%- endfor -%}
                    {%- elsif shirt_prod.variants.size == 1 and shirt_prod.has_only_default_variant -%}
                      {%- assign shirt_sizes = '36,38,40,42,44' | split: ',' -%}
                      {%- for sz in shirt_sizes -%}
                        <button
                          type="button"
                          class="sbl-size-pill {% if forloop.index == 2 %}is-selected{% endif %}"
                          data-variant-id="{{ shirt_prod.variants.first.id }}"
                          data-variant-title="{{ sz }}"
                        >{{ sz }}</button>
                      {%- endfor -%}
                    {%- else -%}
                      <button type="button" class="sbl-size-pill" data-variant-id="demo-shirt-36">36</button>
                      <button type="button" class="sbl-size-pill" data-variant-id="demo-shirt-38">38</button>
                      <button type="button" class="sbl-size-pill is-selected" data-variant-id="demo-shirt-40">40</button>
                      <button type="button" class="sbl-size-pill" data-variant-id="demo-shirt-42">42</button>
                      <button type="button" class="sbl-size-pill" data-variant-id="demo-shirt-44">44</button>
                    {%- endif -%}
                  </div>
                </div>

                {%- comment -%} 2. Pant Size Selector {%- endcomment -%}
                <div class="sbl-piece-box" data-piece="pant">
                  <div class="sbl-piece-header">
                    <span class="sbl-piece-name">2. Pant / Trouser Size</span>
                    <button
                      type="button"
                      class="sbl-size-chart-link"
                      data-open-size-chart="pant"
                      data-custom-image="{{ b_pant_chart }}"
                    >Size chart</button>
                  </div>
                  <div class="sbl-size-pills">
                    {%- if pant_prod.variants.size > 0 and pant_prod.has_only_default_variant == false -%}
                      {%- for variant in pant_prod.variants -%}
                        {%- assign v_label = variant.option2 | default: variant.option1 | default: variant.title -%}
                        <button
                          type="button"
                          class="sbl-size-pill {% if forloop.first %}is-selected{% endif %} {% if variant.available == false %}is-sold-out{% endif %}"
                          data-variant-id="{{ variant.id }}"
                          data-variant-title="{{ variant.title }}"
                          {% if variant.available == false %}disabled{% endif %}
                        >{{ v_label }}</button>
                      {%- endfor -%}
                    {%- elsif pant_prod.variants.size == 1 and pant_prod.has_only_default_variant -%}
                      {%- assign pant_sizes = '30,32,34,36,38' | split: ',' -%}
                      {%- for sz in pant_sizes -%}
                        <button
                          type="button"
                          class="sbl-size-pill {% if forloop.index == 2 %}is-selected{% endif %}"
                          data-variant-id="{{ pant_prod.variants.first.id }}"
                          data-variant-title="{{ sz }}"
                        >{{ sz }}</button>
                      {%- endfor -%}
                    {%- else -%}
                      <button type="button" class="sbl-size-pill" data-variant-id="demo-pant-30">30</button>
                      <button type="button" class="sbl-size-pill is-selected" data-variant-id="demo-pant-32">32</button>
                      <button type="button" class="sbl-size-pill" data-variant-id="demo-pant-34">34</button>
                      <button type="button" class="sbl-size-pill" data-variant-id="demo-pant-36">36</button>
                      <button type="button" class="sbl-size-pill" data-variant-id="demo-pant-38">38</button>
                    {%- endif -%}
                  </div>
                </div>

                {%- comment -%} Quantity Selector {%- endcomment -%}
                <div class="sbl-qty-row">
                  <span class="sbl-qty-label">Quantity:</span>
                  <div class="sbl-qty-ctrl">
                    <button type="button" class="sbl-qty-btn sbl-qty-btn--minus" aria-label="Decrease quantity">−</button>
                    <input type="text" class="sbl-qty-input" value="1" readonly>
                    <button type="button" class="sbl-qty-btn sbl-qty-btn--plus" aria-label="Increase quantity">+</button>
                  </div>
                </div>

                {%- comment -%} Action Buttons {%- endcomment -%}
                <div class="sbl-actions">
                  <button type="button" class="sbl-btn-add" data-add-to-cart data-look-title="{{ look_title }}">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                    <span>ADD TO CART</span>
                  </button>
                  <button type="button" class="sbl-btn-buy" data-buy-it-now data-look-title="{{ look_title }}">
                    BUY IT NOW
                  </button>
                </div>

                <div class="sbl-trust-badges">
                  <span>✓ Free Express Shipping</span>
                  <span>✓ 7-Day Easy Exchange</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}

    {%- comment -%} 2. Demo Modals for Categories with 0 Blocks {%- endcomment -%}
    {%- if vacation_count == 0 -%}
      {%- for vtitle in vac_titles -%}
        {%- assign vimg = vac_imgs[forloop.index0] -%}
        <div id="SBLModalDemo-vacation-{{ forloop.index0 }}" class="sbl-modal" aria-hidden="true">
          <div class="sbl-modal-backdrop" data-close-modal></div>
          <div class="sbl-modal-dialog">
            <button type="button" class="sbl-modal-close" data-close-modal aria-label="Close preview">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
            <div class="sbl-modal-grid">
              <div class="sbl-gallery-wrap">
                <div class="sbl-gallery-stage">
                  <div class="sbl-slide is-active" data-slide-index="0">
                    <img src="{{ vimg }}" alt="{{ vtitle }}" class="sbl-slide-img">
                  </div>
                  <div class="sbl-slide" data-slide-index="1">
                    <img src="{{ vimg }}" alt="{{ vtitle }}" class="sbl-slide-img" style="filter: brightness(1.04);">
                  </div>
                  <div class="sbl-slide" data-slide-index="2">
                    <img src="{{ vimg }}" alt="{{ vtitle }}" class="sbl-slide-img" style="filter: contrast(1.08);">
                  </div>
                  <div class="sbl-slide" data-slide-index="3">
                    <img src="{{ vimg }}" alt="{{ vtitle }}" class="sbl-slide-img" style="filter: saturate(1.1);">
                  </div>
                  <div class="sbl-slide" data-slide-index="4">
                    <img src="{{ vimg }}" alt="{{ vtitle }}" class="sbl-slide-img" style="filter: brightness(0.96);">
                  </div>
                  <div class="sbl-slide" data-slide-index="5">
                    <img src="{{ vimg }}" alt="{{ vtitle }}" class="sbl-slide-img">
                  </div>

                  <button type="button" class="sbl-gallery-arrow sbl-gallery-arrow--prev" aria-label="Previous image">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                  </button>
                  <button type="button" class="sbl-gallery-arrow sbl-gallery-arrow--next" aria-label="Next image">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                  </button>
                </div>

                <div class="sbl-gallery-thumbs">
                  {%- for t in (0..5) -%}
