<script>
  // 1. Ensure .open() on <cart-drawer> triggers .show()
  (function() {
    function setupDrawerMethods() {
      var drawer = document.getElementById('cart-drawer') || document.querySelector('cart-drawer');
      if (drawer && typeof drawer.open !== 'function') {
        drawer.open = function() {
          if (typeof drawer.show === 'function') {
            return drawer.show();
          } else {
            drawer.setAttribute('open', '');
            drawer.classList.add('active', 'is-open');
            drawer.setAttribute('aria-hidden', 'false');
          }
        };
      }
    }
    setupDrawerMethods();
    document.addEventListener('DOMContentLoaded', setupDrawerMethods);
    if (window.customElements) {
      customElements.whenDefined('cart-drawer').then(setupDrawerMethods).catch(function() {});
    }
  })();

  // 2. Global Capture-Phase Interceptor for Bag Icon & All Cart Drawer Triggers
  document.addEventListener('click', function(e) {
    var cartTrigger = e.target && e.target.closest && e.target.closest(
      'a[href="/cart"], a[href$="/cart"], a[href*="/cart"], [aria-controls="cart-drawer"], .header__cart-link, .header__cart-link a, [data-cart-drawer-toggle], .header__icon--cart, [data-cart-toggle], [data-open-cart-drawer]'
    );
    if (!cartTrigger) return;

    // Do NOT intercept links inside the cart drawer itself (e.g. checkout button or view cart link)
    if (cartTrigger.closest('cart-drawer, #cart-drawer, .cart-drawer__footer') ||
        cartTrigger.name === 'checkout' ||
        cartTrigger.getAttribute('href') === '/checkout' ||
        cartTrigger.classList.contains('cart-drawer__view-cart')) {
      return;
    }

    // Stop browser from navigating to /cart immediately
    e.preventDefault();
    e.stopPropagation();
    if (e.stopImmediatePropagation) {
      e.stopImmediatePropagation();
    }

    var drawer = document.getElementById('cart-drawer') || document.querySelector('cart-drawer');
    if (drawer) {
      if (drawer.hasAttribute('open') || drawer.open === true) {
        if (typeof drawer.hide === 'function') {
          drawer.hide();
        } else {
          drawer.removeAttribute('open');
        }
      } else {
        if (typeof drawer.show === 'function') {
          drawer.show();
        } else if (typeof drawer.open === 'function') {
          drawer.open();
        } else {
          drawer.setAttribute('open', '');
          drawer.classList.add('active', 'is-open');
          drawer.setAttribute('aria-hidden', 'false');
        }
      }
    }
  }, true);

  // 3. Global Event Listeners: Allow any page or section to open this drawer
  ['cart:open', 'cart:force_open', 'cart-drawer:open', 'theme:cart:open'].forEach(function(evt) {
    document.addEventListener(evt, function() {
      var drawer = document.getElementById('cart-drawer') || document.querySelector('cart-drawer');
      if (drawer) {
        if (typeof drawer.show === 'function') drawer.show();
        else if (typeof drawer.open === 'function') drawer.open();
        else drawer.setAttribute('open', '');
      }
    });
  });

  // 4. Addon Product Adder (+ ADD button in shirt/pant carousel)
  if (!window.addCartAddon) {
    window.addCartAddon = function(btn, event) {
      if (event) {
        if (event._addonHandled) return;
        event._addonHandled = true;
        if (event.preventDefault) event.preventDefault();
        if (event.stopPropagation) event.stopPropagation();
      }

      if (!btn || btn.dataset.adding === 'true' || btn.disabled) return;

      var card = btn.closest('.addon-card');
      var variantId = btn.getAttribute('data-variant-id');

      if (card) {
        var select = card.querySelector('[data-addon-select]');
        if (select && select.value) {
          variantId = select.value;
        } else {
          var hiddenInput = card.querySelector('.addon-card__variant-id');
          if (hiddenInput && hiddenInput.value) {
            variantId = hiddenInput.value;
          }
        }
      }

      if (!variantId) {
        alert('Please select a variant.');
        return;
      }

      btn.dataset.adding = 'true';
      btn.disabled = true;
      var originalText = btn.textContent;
      btn.textContent = '...';

      var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      var addUrl = root + (root.endsWith('/') ? '' : '/') + 'cart/add.js';

      var formData = new FormData();
      formData.append('id', variantId);
      formData.append('quantity', '1');

      fetch(addUrl, {
        method: 'POST',
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'Accept': 'application/json'
        },
        body: formData
      })
      .then(function(res) {
        return res.json().then(function(data) {
          return { ok: res.ok, status: res.status, data: data };
        });
      })
      .then(function(result) {
        if (!result.ok) {
          var errorMsg = (result.data && (result.data.description || result.data.message)) || 'Could not add item to cart.';
          alert(errorMsg);
          btn.dataset.adding = 'false';
          btn.disabled = false;
          btn.textContent = originalText;
          return;
        }

        btn.textContent = '✓ ADDED';
        btn.classList.add('is-added');

        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
        document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
      })
      .catch(function(err) {
        console.error('Error adding addon product:', err);
        btn.dataset.adding = 'false';
        btn.disabled = false;
        btn.textContent = originalText;
      });
    };
  }

  // 5. Discount Code Copy & Apply Helper
  if (!window.copyDuchCode) {
    window.copyDuchCode = function(badgeEl, code) {
      if (!code) return;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(code).then(function() {
          var original = badgeEl.textContent;
          badgeEl.textContent = 'COPIED!';
          setTimeout(function() {
            badgeEl.textContent = original;
          }, 1800);
        }).catch(function() {});
      }

      var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      fetch(root + (root.endsWith('/') ? '' : '/') + 'cart/update.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ discount: code })
      })
      .then(function(res) { return res.json(); })
      .then(function() {
        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
      })
      .catch(function(err) {
        console.error('Error applying discount code:', err);
      });
    };
  }

  // 6. Auto-sync discount code for the current tiered offer
  {%- assign current_cart_discount = blank -%}
  {%- for discount_app in cart.cart_level_discount_applications -%}
    {%- assign current_cart_discount = discount_app.title -%}
  {%- endfor -%}
  (function() {
    var targetBadge = {{ current_badge | json }};
    var currentApplied = {{ current_cart_discount | json }};

    if (targetBadge && targetBadge !== '' && currentApplied !== targetBadge) {
      if (window.__duchAutoAppliedBadge !== targetBadge) {
        window.__duchAutoAppliedBadge = targetBadge;
        var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
        fetch(root + (root.endsWith('/') ? '' : '/') + 'cart/update.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ discount: targetBadge })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data && data.discount_codes) {
            document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          }
        })
        .catch(function(err) {
          console.warn('Discount sync notice:', err);
        });
      }
    }
  })();

  // 7. Order Summary Accordion Drawer Toggle
  if (!window.toggleOrderSummaryDrawer) {
    window.toggleOrderSummaryDrawer = function(targetOrEvent, maybeEvent) {
      var e = maybeEvent || (targetOrEvent && (targetOrEvent.preventDefault || targetOrEvent.stopPropagation) ? targetOrEvent : null);
      if (e) {
        if (e._duchDrawerHandled) return;
        e._duchDrawerHandled = true;
        if (e.preventDefault) e.preventDefault();
        if (e.stopPropagation) e.stopPropagation();
      }
      var el = (targetOrEvent && targetOrEvent.nodeType) ? targetOrEvent : (e && e.target ? e.target : null);
      var drawer = el && el.closest ? el.closest('.gokwik-bottom-drawer') : document.getElementById('gokwik-bottom-drawer');
      if (!drawer) {
        drawer = document.querySelector('.gokwik-bottom-drawer');
      }
      if (!drawer) return;
      var isOpen = drawer.classList.toggle('is-open');
      var trigger = drawer.querySelector('.gokwik-card__trigger');
      var content = drawer.querySelector('.gokwik-drawer-content');
      if (trigger) {
        trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      }
      if (content) {
        content.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
      }
    };
  }

  // 8. Delegated event listener inside drawer for accordion and addon clicks
  document.addEventListener('click', function(e) {
    var trigger = e.target && e.target.closest ? e.target.closest('.gokwik-card__trigger') : null;
    if (trigger) {
      window.toggleOrderSummaryDrawer(trigger, e);
      return;
    }

    var addonBtn = e.target && e.target.closest ? e.target.closest('.addon-card__add-btn') : null;
    if (addonBtn && !addonBtn.disabled && addonBtn.dataset.adding !== 'true') {
      window.addCartAddon(addonBtn, e);
    }
  });
</script>

