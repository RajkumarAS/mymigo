{%- comment -%}
  DUCH STANDALONE CART DRAWER
  Works 100% independently alongside any existing theme cart drawer without collision.
  Features:
  - Tiered Quantity Discount & Free Shipping Bar (DUCH200 - DUCH1800)
  - Self-contained Cart Items List with Quantity +/- & Remove
  - Add-On Products Carousel (Shirt & Pant selection with + ADD)
  - Gokwik Style Bottom Order Summary Drawer with Price Breakdown
  - Direct Checkout with Pre-applied Tiered Discount
{%- endcomment -%}

{%- liquid
  assign item_qty = cart.item_count
  assign progress_percent = 0
  assign current_badge = blank
  assign line1_text = blank
  assign line2_text = blank

  if item_qty == 0
    assign progress_percent = 0
    assign line1_text = "Your cart is empty"
  elsif item_qty == 1
    assign progress_percent = 11
    assign current_badge = "DUCH200"
    assign line1_text = "🎉 <strong>₹200 OFF Unlocked!</strong>"
    assign line2_text = "Standard Shipping (₹80) applied • Add 1 more item for FREE Shipping & ₹400 OFF"
  elsif item_qty == 2
    assign progress_percent = 22
    assign current_badge = "DUCH400"
    assign line1_text = "🎉 <strong>FREE Shipping & ₹400 OFF Unlocked!</strong>"
    assign line2_text = "Add 1 more item for ₹600 OFF"
  elsif item_qty == 3
    assign progress_percent = 33
    assign current_badge = "DUCH600"
    assign line1_text = "🎉 <strong>FREE Shipping & ₹600 OFF Unlocked!</strong>"
    assign line2_text = "Add 1 more item for ₹800 OFF"
  elsif item_qty == 4
    assign progress_percent = 44
    assign current_badge = "DUCH800"
    assign line1_text = "🎉 <strong>FREE Shipping & ₹800 OFF Unlocked!</strong>"
    assign line2_text = "Add 1 more item for ₹1,000 OFF"
  elsif item_qty == 5
    assign progress_percent = 55
    assign current_badge = "DUCH1000"
    assign line1_text = "🎉 <strong>FREE Shipping & ₹1,000 OFF Unlocked!</strong>"
    assign line2_text = "Add 1 more item for ₹1,200 OFF"
  elsif item_qty == 6
    assign progress_percent = 66
    assign current_badge = "DUCH1200"
    assign line1_text = "🎉 <strong>FREE Shipping & ₹1,200 OFF Unlocked!</strong>"
    assign line2_text = "Add 1 more item for ₹1,400 OFF"
  elsif item_qty == 7
    assign progress_percent = 77
    assign current_badge = "DUCH1400"
    assign line1_text = "🎉 <strong>FREE Shipping & ₹1,400 OFF Unlocked!</strong>"
    assign line2_text = "Add 1 more item for ₹1,600 OFF"
  elsif item_qty == 8
    assign progress_percent = 88
    assign current_badge = "DUCH1600"
    assign line1_text = "🎉 <strong>FREE Shipping & ₹1,600 OFF Unlocked!</strong>"
    assign line2_text = "Add 1 more item for ₹1,800 OFF"
  elsif item_qty >= 9
    assign progress_percent = 100
    assign current_badge = "DUCH1800"
    assign line1_text = "🎉 <strong>MAXIMUM TIER UNLOCKED!</strong>"
    assign line2_text = "FREE Shipping & ₹1,800 OFF Applied"
  else
    assign progress_percent = 100
    assign current_badge = "DUCH1800"
    assign line1_text = "🎉 <strong>MAXIMUM TIER UNLOCKED!</strong>"
    assign line2_text = "FREE Shipping & ₹1,800 OFF Applied"
  endif
-%}

<div id="duch-cart-drawer" class="duch-cart-drawer" aria-hidden="true" data-section-id="{{ section.id }}">
  <div class="duch-cart-drawer__backdrop" onclick="window.closeDuchCartDrawer && window.closeDuchCartDrawer()"></div>

  <div class="duch-cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Cart">
    <div class="duch-cart-drawer__header">
      <h2 class="duch-cart-drawer__title">Cart</h2>
      <button type="button" class="duch-cart-drawer__close" onclick="window.closeDuchCartDrawer && window.closeDuchCartDrawer()" aria-label="Close cart">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="duch-cart-drawer__body" id="duch-cart-drawer-body">
      {%- if cart.empty? -%}
        <div class="duch-cart-drawer__empty text-center">
          <p class="duch-cart-empty-title">Your cart is empty</p>
          <p class="duch-cart-empty-subtitle">Looks like you haven't added any items to your bag yet.</p>
          <button type="button" class="duch-cart-empty-btn" onclick="window.closeDuchCartDrawer && window.closeDuchCartDrawer()">
            Continue Shopping
          </button>
        </div>
      {%- else -%}

        {%- if item_qty > 0 -%}
          <div class="cart-drawer__tiered-bar">
            <div class="tiered-bar__header-row">
              <div class="tiered-bar__line1">{{ line1_text }}</div>
              {%- if current_badge != blank -%}
                <span
                  class="tiered-bar__badge"
                  onclick="window.copyDuchCode && window.copyDuchCode(this, '{{ current_badge }}')"
                  title="Click to copy & apply {{ current_badge }}"
                >{{ current_badge }}</span>
              {%- endif -%}
            </div>
            {%- if line2_text != blank -%}
              <div class="tiered-bar__line2">{{ line2_text }}</div>
            {%- endif -%}
            <div class="tiered-bar__progress-track">
              <div class="tiered-bar__progress-fill" style="width: {{ progress_percent }}%;"></div>
            </div>
          </div>
        {%- endif -%}

        <div class="duch-cart-items">
          {%- for line_item in cart.items -%}
            <div class="duch-cart-item" data-line-key="{{ line_item.key }}">
              <div class="duch-cart-item__media">
                {%- if line_item.image -%}
                  {{ line_item.image | image_url: width: 220 | image_tag: loading: 'lazy', class: 'duch-cart-item__img', alt: line_item.title }}
                {%- endif -%}
              </div>

              <div class="duch-cart-item__details">
                <a href="{{ line_item.url }}" class="duch-cart-item__title">{{ line_item.product.title }}</a>

                {%- unless line_item.product.has_only_default_variant -%}
                  <div class="duch-cart-item__variant">{{ line_item.variant.title }}</div>
                {%- endunless -%}

                {%- if line_item.properties.size > 0 -%}
                  <div class="duch-cart-item__properties">
                    {%- for prop in line_item.properties -%}
                      {%- assign first_char = prop.first | slice: 0 -%}
                      {%- unless first_char == '_' or prop.last == blank -%}
                        <span class="duch-cart-item__property">{{ prop.first }}: {{ prop.last }}</span>
                      {%- endunless -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                <div class="duch-cart-item__price-row">
                  {%- if line_item.original_price > line_item.final_price -%}
                    <span class="duch-cart-item__price duch-cart-item__price--final">{{ line_item.final_price | money }}</span>
                    <span class="duch-cart-item__price duch-cart-item__price--compare">{{ line_item.original_price | money }}</span>
                  {%- elsif line_item.variant.compare_at_price > line_item.variant.price -%}
                    <span class="duch-cart-item__price duch-cart-item__price--final">{{ line_item.final_price | money }}</span>
                    <span class="duch-cart-item__price duch-cart-item__price--compare">{{ line_item.variant.compare_at_price | money }}</span>
                  {%- else -%}
                    <span class="duch-cart-item__price duch-cart-item__price--final">{{ line_item.final_price | money }}</span>
                  {%- endif -%}
                </div>

                <div class="duch-cart-item__actions">
                  <div class="duch-qty-selector">
                    <button
                      type="button"
                      class="duch-qty-btn"
                      onclick="window.changeDuchCartQty && window.changeDuchCartQty('{{ line_item.key }}', {{ line_item.quantity | minus: 1 }})"
                      aria-label="Decrease quantity"
                    >−</button>
                    <span class="duch-qty-val">{{ line_item.quantity }}</span>
                    <button
                      type="button"
                      class="duch-qty-btn"
                      onclick="window.changeDuchCartQty && window.changeDuchCartQty('{{ line_item.key }}', {{ line_item.quantity | plus: 1 }})"
                      aria-label="Increase quantity"
                    >+</button>
                  </div>

                  <button
                    type="button"
                    class="duch-cart-item__remove"
                    onclick="window.changeDuchCartQty && window.changeDuchCartQty('{{ line_item.key }}', 0)"
                  >
                    Remove
                  </button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- comment -%} ADD-ON PRODUCTS SECTION (HORIZONTALLY SCROLLABLE CAROUSEL) {%- endcomment -%}
        {%- assign addon_list = section.settings.addon_products -%}
        {%- if addon_list == blank or addon_list.size == 0 -%}
          {%- assign addon_list = section.settings.cross_sell_products -%}
        {%- endif -%}

        {%- if addon_list != blank and addon_list.size > 0 -%}
          <div class="cart-drawer__addon-section">
            <div class="addon-section__header">
              <p class="h6">{{ section.settings.addon_title | default: 'Add On Products (Shirt & Pant)' }}</p>
            </div>

            <div class="addon-section__scroll-wrapper">
              <div class="addon-section__list">
                {%- for addon_prod in addon_list -%}
                  {%- if addon_prod.available -%}
                    {%- assign is_in_cart = false -%}
                    {%- for cart_item in cart.items -%}
                      {%- if cart_item.product_id == addon_prod.id -%}
                        {%- assign is_in_cart = true -%}
                      {%- endif -%}
                    {%- endfor -%}

                    <div class="addon-card {% if is_in_cart %}is-in-cart{% endif %}">
                      <div class="addon-card__image-wrap">
                        {%- if addon_prod.featured_media -%}
                          {{ addon_prod.featured_media | image_url: width: 300 | image_tag: loading: 'lazy', class: 'addon-card__img', alt: addon_prod.title }}
                        {%- endif -%}
                      </div>

                      <div class="addon-card__info">
                        <a href="{{ addon_prod.url }}" class="addon-card__title" title="{{ addon_prod.title }}">{{ addon_prod.title }}</a>
                        {%- assign addon_offer_price = addon_prod.price | minus: 20000 -%}
                        <div class="addon-card__price">
                          <span>{{ addon_offer_price | money }}</span>
                          <span class="addon-card__compare-price">{{ addon_prod.price | money }}</span>
                        </div>

                        {%- if addon_prod.variants.size > 1 -%}
                          <select class="addon-card__variant-select" data-addon-select {% if is_in_cart %}disabled{% endif %}>
                            {%- for variant in addon_prod.variants -%}
                              {%- if variant.available -%}
                                <option value="{{ variant.id }}">{{ variant.title }}</option>
                              {%- endif -%}
                            {%- endfor -%}
                          </select>
                        {%- else -%}
                          <input type="hidden" class="addon-card__variant-id" value="{{ addon_prod.selected_or_first_available_variant.id | default: addon_prod.variants.first.id }}">
                        {%- endif -%}
                      </div>

                      <div class="addon-card__action">
                        {%- if is_in_cart -%}
                          <button type="button" class="addon-card__add-btn is-added" disabled>
                            ✓ ADDED
                          </button>
                        {%- else -%}
                          <button
                            type="button"
                            class="addon-card__add-btn"
                            onclick="window.addCartAddon && window.addCartAddon(this, event)"
                            data-variant-id="{{ addon_prod.selected_or_first_available_variant.id | default: addon_prod.variants.first.id }}"
                          >
                            + ADD
                          </button>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        {%- endif -%}

      {%- endif -%}
    </div>

    {%- unless cart.empty? -%}
      <div class="duch-cart-drawer__footer" id="duch-cart-drawer-footer">
        <form action="{{ routes.cart_url }}" method="POST" class="duch-footer-form">
          {%- if current_badge != blank -%}
            <input type="hidden" name="discount" value="{{ current_badge }}">
          {%- endif -%}

          {%- if section.settings.show_cart_note -%}
            <details class="duch-order-note-details">
              <summary class="duch-order-note-summary">Add order note</summary>
              <div class="duch-order-note-wrap">
                <textarea
                  name="note"
                  rows="3"
                  class="duch-order-note-input"
                  placeholder="Special instructions for seller..."
                >{{ cart.note }}</textarea>
              </div>
            </details>
          {%- endif -%}

          {%- if section.settings.show_shipping_text -%}
            <p class="duch-shipping-text">Taxes and shipping calculated at checkout</p>
          {%- endif -%}

          {%- comment -%} GOKWIK / NATIVE ORDER SUMMARY DRAWER {%- endcomment -%}
          {%- liquid
            assign mrp_total = 0
            for item in cart.items
              if item.variant.compare_at_price and item.variant.compare_at_price > item.variant.price
                assign line_mrp = item.variant.compare_at_price | times: item.quantity
              else
                assign line_mrp = item.original_line_price
              endif
              assign mrp_total = mrp_total | plus: line_mrp
            endfor

            assign tiered_discount_amount = 0
            if item_qty == 1
              assign tiered_discount_amount = 20000
            elsif item_qty == 2
              assign tiered_discount_amount = 40000
            elsif item_qty == 3
              assign tiered_discount_amount = 60000
            elsif item_qty == 4
              assign tiered_discount_amount = 80000
            elsif item_qty == 5
              assign tiered_discount_amount = 100000
            elsif item_qty == 6
              assign tiered_discount_amount = 120000
            elsif item_qty == 7
              assign tiered_discount_amount = 140000
            elsif item_qty == 8
              assign tiered_discount_amount = 160000
            elsif item_qty >= 9
              assign tiered_discount_amount = 180000
            endif

            assign shipping_fee = 0
            if item_qty == 1
              assign shipping_fee = 8000
            endif

            assign subtotal_price = cart.total_price
            assign total_savings = mrp_total | minus: subtotal_price | plus: tiered_discount_amount
            assign final_total = subtotal_price | minus: tiered_discount_amount | plus: shipping_fee
            if final_total < 0
              assign final_total = 0
            endif

            assign discount_percent = 0
            if mrp_total > 0
              assign discount_percent = total_savings | times: 100 | divided_by: mrp_total
            endif
          -%}

          <div class="cart-drawer__gokwik-summary">
            {%- if total_savings > 0 -%}
              <div class="gokwik-savings-badge">
                🎉 {{ total_savings | money }} Saved so far!
              </div>
            {%- endif -%}

            <div class="gokwik-bottom-drawer" id="gokwik-bottom-drawer">
              <button
                type="button"
                class="gokwik-card__trigger"
                onclick="window.toggleOrderSummaryDrawer && window.toggleOrderSummaryDrawer(this, event)"
                aria-expanded="false"
              >
                <div class="gokwik-trigger__left">
                  <span class="gokwik-trigger__icon">₹</span>
                  <span class="gokwik-trigger__title">Estimated Total</span>
                  <svg class="gokwik-trigger__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </div>
                <div class="gokwik-trigger__right">
                  {%- if mrp_total > final_total -%}
                    <span class="gokwik-trigger__mrp">{{ mrp_total | money }}</span>
                  {%- endif -%}
                  <span class="gokwik-trigger__final">{{ final_total | money }}</span>
                  {%- if discount_percent > 0 -%}
                    <span class="gokwik-trigger__discount">({{ discount_percent }}% OFF)</span>
                  {%- endif -%}
                </div>
              </button>

              <div class="gokwik-pill-row">
                <span class="gokwik-pill gokwik-pill--shipping">
                  🚚 Shipping: {% if shipping_fee > 0 %}₹80{% else %}FREE{% endif %}
                </span>
                {%- if current_badge != blank -%}
                  <span class="gokwik-pill gokwik-pill--code">
                    🏷️ {{ current_badge }} Applied
                  </span>
                {%- endif -%}
              </div>

              <div class="gokwik-drawer-content" aria-hidden="true">
                <div class="gokwik-table">
                  <div class="gokwik-row">
                    <span class="gokwik-row-label">Total MRP</span>
                    <span class="gokwik-row-value">{{ mrp_total | money }}</span>
                  </div>

                  {%- if tiered_discount_amount > 0 -%}
                    <div class="gokwik-row gokwik-row--discount">
                      <span class="gokwik-row-label">Tiered Offer Discount</span>
                      <span class="gokwik-row-value">-{{ tiered_discount_amount | money }}</span>
                    </div>
                  {%- endif -%}

                  <div class="gokwik-row">
                    <span class="gokwik-row-label">Shipping</span>
                    <span class="gokwik-row-value">{% if shipping_fee > 0 %}₹80{% else %}<strong style="color: #16a34a;">FREE</strong>{% endif %}</span>
                  </div>

                  <div class="gokwik-divider"></div>

                  <div class="gokwik-row gokwik-row--total">
                    <span class="gokwik-row-label">Estimated Total</span>
                    <span class="gokwik-row-value gokwik-total-val">{{ final_total | money }}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="duch-drawer__btn-group">
            {%- if section.settings.show_view_cart_button -%}
              <a href="{{ routes.cart_url }}" class="duch-drawer__view-cart-btn">
                View Cart
              </a>
            {%- endif -%}

            {%- if section.settings.show_checkout_button -%}
              <button type="submit" name="checkout" class="duch-drawer__checkout-btn">
                <span>CHECKOUT</span>
                <span class="duch-drawer__checkout-dot">•</span>
                <span>{{ final_total | money }}</span>
              </button>
            {%- endif -%}
          </div>
        </form>
      </div>
    {%- endunless -%}
  </div>
</div>

<style>
  /* STANDALONE DUCH CART DRAWER ROOT & OVERLAY */
  .duch-cart-drawer {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    height: 100dvh !important;
    z-index: 2147483640 !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
    transition: visibility 0.3s ease, opacity 0.3s ease !important;
  }

  .duch-cart-drawer.is-open {
    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  .duch-cart-drawer__backdrop {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background: rgba(0, 0, 0, 0.55) !important;
    backdrop-filter: blur(2px) !important;
    -webkit-backdrop-filter: blur(2px) !important;
  }

  .duch-cart-drawer__panel {
    position: absolute !important;
    top: 0 !important;
    right: 0 !important;
    width: 100% !important;
    max-width: 440px !important;
    height: 100% !important;
    background: #ffffff !important;
    color: #18181b !important;
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.18) !important;
    display: flex !important;
    flex-direction: column !important;
    transform: translateX(100%) !important;
    transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
    box-sizing: border-box !important;
  }

  .duch-cart-drawer.is-open .duch-cart-drawer__panel {
    transform: translateX(0) !important;
  }

  /* DRAWER HEADER */
  .duch-cart-drawer__header {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 16px 20px !important;
    border-bottom: 1px solid #e4e4e7 !important;
    background: #ffffff !important;
  }

  .duch-cart-drawer__title {
    font-size: 16px !important;
    font-weight: 700 !important;
    letter-spacing: 0.05em !important;
    text-transform: uppercase !important;
    color: #18181b !important;
    margin: 0 !important;
  }

  .duch-cart-drawer__close {
    background: transparent !important;
    border: none !important;
    color: #71717a !important;
    cursor: pointer !important;
    padding: 6px !important;
    border-radius: 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: color 0.15s ease, background 0.15s ease !important;
  }

  .duch-cart-drawer__close:hover {
    color: #18181b !important;
    background: #f4f4f5 !important;
  }

  /* DRAWER BODY */
  .duch-cart-drawer__body {
    flex: 1 1 auto !important;
    overflow-y: auto !important;
    -webkit-overflow-scrolling: touch !important;
    padding: 16px 20px !important;
  }

  /* EMPTY STATE */
  .duch-cart-drawer__empty {
    padding: 60px 20px !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
  }

  .duch-cart-empty-title {
    font-size: 18px !important;
    font-weight: 700 !important;
    color: #18181b !important;
    margin-bottom: 6px !important;
  }

  .duch-cart-empty-subtitle {
    font-size: 13.5px !important;
    color: #71717a !important;
    margin-bottom: 20px !important;
  }

  .duch-cart-empty-btn {
    background: #18181b !important;
    color: #ffffff !important;
    border: none !important;
    padding: 10px 24px !important;
    border-radius: 8px !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    cursor: pointer !important;
  }

  /* TIERED DISCOUNTS & SHIPPING BAR STYLES */
  .cart-drawer__tiered-bar {
    background: #18181b !important;
    color: #ffffff !important;
    padding: 14px 16px !important;
    margin: 0 0 16px !important;
    border-radius: 10px !important;
  }

  .tiered-bar__header-row {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 8px !important;
  }

  .tiered-bar__line1 {
    font-size: 13.5px !important;
    color: #ffffff !important;
    line-height: 1.3 !important;
  }

  .tiered-bar__line2 {
    font-size: 12px !important;
    color: #d4d4d8 !important;
    margin-top: 4px !important;
    line-height: 1.3 !important;
  }

  .tiered-bar__badge {
    background: #22c55e !important;
    color: #ffffff !important;
    font-size: 10px !important;
    font-weight: 700 !important;
    padding: 2px 8px !important;
    border-radius: 4px !important;
    letter-spacing: 0.05em !important;
    text-transform: uppercase !important;
    flex-shrink: 0 !important;
    cursor: pointer !important;
    user-select: none !important;
    transition: transform 0.15s ease, background-color 0.15s ease !important;
  }

  .tiered-bar__badge:hover {
    background-color: #16a34a !important;
    transform: scale(1.05) !important;
  }

  .tiered-bar__progress-track {
    width: 100% !important;
    height: 5px !important;
    background: #3f3f46 !important;
    border-radius: 9999px !important;
