</style>

<script>
  // 1. OPEN / CLOSE HANDLERS
  window.openDuchCartDrawer = function() {
    var drawer = document.getElementById('duch-cart-drawer');
    if (drawer) {
      drawer.setAttribute('aria-hidden', 'false');
      drawer.classList.add('is-open');
      document.documentElement.classList.add('duch-drawer-locked');
      document.body.classList.add('duch-drawer-locked');
    }
  };

  window.closeDuchCartDrawer = function() {
    var drawer = document.getElementById('duch-cart-drawer');
    if (drawer) {
      drawer.setAttribute('aria-hidden', 'true');
      drawer.classList.remove('is-open');
      document.documentElement.classList.remove('duch-drawer-locked');
      document.body.classList.remove('duch-drawer-locked');
    }
  };

  window.toggleDuchCartDrawer = function() {
    var drawer = document.getElementById('duch-cart-drawer');
    if (drawer) {
      if (drawer.classList.contains('is-open')) {
        window.closeDuchCartDrawer();
      } else {
        window.openDuchCartDrawer();
      }
    }
  };

  // Close on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' || e.keyCode === 27) {
      var drawer = document.getElementById('duch-cart-drawer');
      if (drawer && drawer.classList.contains('is-open')) {
        window.closeDuchCartDrawer();
      }
    }
  });

  // Dedicated Open Events (Allows Runway & custom buttons to open this drawer specifically)
  ['duch:drawer:open', 'duch:cart:open'].forEach(function(evt) {
    document.addEventListener(evt, function() {
      window.openDuchCartDrawer();
    });
  });

  // Catch clicks on any elements with data-duch-cart-open
  document.addEventListener('click', function(e) {
    var trigger = e.target && e.target.closest && e.target.closest('[data-duch-cart-open], [data-open-duch-drawer], [data-duch-open]');
    if (trigger) {
      e.preventDefault();
      window.openDuchCartDrawer();
    }
  });

  // 2. QUANTITY CHANGER (+ / - / Remove)
  window.changeDuchCartQty = function(lineKey, newQuantity) {
    if (!lineKey) return;
    var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    var changeUrl = root + (root.endsWith('/') ? '' : '/') + 'cart/change.js';

    fetch(changeUrl, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify({
        id: lineKey,
        quantity: parseInt(newQuantity, 10)
      })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      // Re-render standalone drawer
      window.refreshDuchCartDrawer();

      // Dispatch standard cart refresh for store headers
      document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
      document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
    })
    .catch(function(err) {
      console.error('Error updating cart quantity:', err);
    });
  };

  // 3. ADDON PRODUCT ADDER
  if (!window.addCartAddon) {
    window.addCartAddon = function(btn, event) {
      if (event) {
        if (event._addonHandled) return;
        event._addonHandled = true;
        if (event.preventDefault) event.preventDefault();
        if (event.stopPropagation) event.stopPropagation();
      }

      if (!btn || btn.dataset.adding === 'true' || btn.disabled) return;

      var card = btn.closest('.addon-card');
      var variantId = btn.getAttribute('data-variant-id');

      if (card) {
        var select = card.querySelector('[data-addon-select]');
        if (select && select.value) {
          variantId = select.value;
        } else {
          var hiddenInput = card.querySelector('.addon-card__variant-id');
          if (hiddenInput && hiddenInput.value) {
            variantId = hiddenInput.value;
          }
        }
      }

      if (!variantId) {
        alert('Please select a variant.');
        return;
      }

      btn.dataset.adding = 'true';
      btn.disabled = true;
      var originalText = btn.textContent;
      btn.textContent = '...';

      var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      var addUrl = root + (root.endsWith('/') ? '' : '/') + 'cart/add.js';

      var formData = new FormData();
      formData.append('id', variantId);
      formData.append('quantity', '1');

      fetch(addUrl, {
        method: 'POST',
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'Accept': 'application/json'
        },
        body: formData
      })
      .then(function(res) {
        return res.json().then(function(data) {
          return { ok: res.ok, status: res.status, data: data };
        });
      })
      .then(function(result) {
        if (!result.ok) {
          var errorMsg = (result.data && (result.data.description || result.data.message)) || 'Could not add item to cart.';
          alert(errorMsg);
          btn.dataset.adding = 'false';
          btn.disabled = false;
          btn.textContent = originalText;
          return;
        }

        btn.textContent = '✓ ADDED';
        btn.classList.add('is-added');

        window.refreshDuchCartDrawer();

        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
        document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
      })
      .catch(function(err) {
        console.error('Error adding addon product:', err);
        btn.dataset.adding = 'false';
        btn.disabled = false;
        btn.textContent = originalText;
      });
    };
  }

  // 4. DISCOUNT CODE COPY & APPLY HELPER
  if (!window.copyDuchCode) {
    window.copyDuchCode = function(badgeEl, code) {
      if (!code) return;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(code).then(function() {
          var original = badgeEl.textContent;
          badgeEl.textContent = 'COPIED!';
          setTimeout(function() {
            badgeEl.textContent = original;
          }, 1800);
        }).catch(function() {});
      }

      var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      fetch(root + (root.endsWith('/') ? '' : '/') + 'cart/update.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ discount: code })
      })
      .then(function(res) { return res.json(); })
      .then(function() {
        window.refreshDuchCartDrawer();
        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
      })
      .catch(function(err) {
        console.error('Error applying discount code:', err);
      });
    };
  }

  // 5. GOKWIK ACCORDION TOGGLE
  if (!window.toggleOrderSummaryDrawer) {
    window.toggleOrderSummaryDrawer = function(targetOrEvent, maybeEvent) {
      var e = maybeEvent || (targetOrEvent && (targetOrEvent.preventDefault || targetOrEvent.stopPropagation) ? targetOrEvent : null);
      if (e) {
        if (e._duchDrawerHandled) return;
        e._duchDrawerHandled = true;
        if (e.preventDefault) e.preventDefault();
        if (e.stopPropagation) e.stopPropagation();
      }
      var el = (targetOrEvent && targetOrEvent.nodeType) ? targetOrEvent : (e && e.target ? e.target : null);
      var drawer = el && el.closest ? el.closest('.gokwik-bottom-drawer') : document.getElementById('gokwik-bottom-drawer');
      if (!drawer) drawer = document.querySelector('.gokwik-bottom-drawer');
      if (!drawer) return;
      var isOpen = drawer.classList.toggle('is-open');
      var trigger = drawer.querySelector('.gokwik-card__trigger');
      var content = drawer.querySelector('.gokwik-drawer-content');
      if (trigger) trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      if (content) content.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
    };
  }

  // 6. DYNAMIC SECTION RE-RENDER (AJAX REFRESH)
  window.refreshDuchCartDrawer = function() {
    var drawerEl = document.getElementById('duch-cart-drawer');
    if (!drawerEl) return;
    var sectionId = drawerEl.getAttribute('data-section-id');
    var fetchUrl = window.location.pathname + '?section_id=' + sectionId;

    fetch(fetchUrl)
      .then(function(res) { return res.text(); })
      .then(function(html) {
        var parser = new DOMParser();
        var doc = parser.parseFromString(html, 'text/html');

        var newBody = doc.getElementById('duch-cart-drawer-body');
        var curBody = document.getElementById('duch-cart-drawer-body');
        if (newBody && curBody) {
          curBody.innerHTML = newBody.innerHTML;
        }

        var newFooter = doc.getElementById('duch-cart-drawer-footer');
        var curFooter = document.getElementById('duch-cart-drawer-footer');
        if (newFooter && curFooter) {
          curFooter.innerHTML = newFooter.innerHTML;
        } else if (newFooter && !curFooter) {
          var panel = drawerEl.querySelector('.duch-cart-drawer__panel');
          if (panel) panel.appendChild(newFooter);
        } else if (!newFooter && curFooter) {
          curFooter.remove();
        }
      })
      .catch(function(err) {
        console.warn('Could not refresh duch drawer HTML:', err);
      });
  };

  // Also listen for general cart refresh
  document.addEventListener('cart:refresh', function() {
    window.refreshDuchCartDrawer();
  });
</script>

