# NutriSnap Environment Configuration
# Copy this file to .env and set your server secret keys.
# NEVER commit .env to public repositories or expose keys in the frontend.

# Server Port (default: 8080)
PORT=8080

# Google Gemini API Key
# Required for live vision food analysis (gemini-2.5-flash / gemini-1.5-flash)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=
