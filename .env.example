# MyMigo Server Configuration
# Copy this file to .env and fill in your values.
PORT=3005

# ----------------------------------------------------------------------------
# Supabase Database Configuration
# ----------------------------------------------------------------------------
# Format A: Using Project URL and Publishable/Anon Key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_publishable_key_here

# Format B: Or directly using Project ID & Publishable Key
# SUPABASE_PROJECT_ID=your-project-id
# SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# ----------------------------------------------------------------------------
# Google Sheets (Optional for live booking calendar sync)
# ----------------------------------------------------------------------------
# GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_MACRO_ID/exec
# GOOGLE_APPS_SCRIPT_SECRET=your_apps_script_secret_here

