# MyMigo MVP Environment Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit .env or put private keys in frontend JavaScript files.

# Server Port
PORT=3000

# ------------------------------------------------------------------
# Google Sheets Booking Storage (Choose Option A OR Option B)
# ------------------------------------------------------------------

# Option A: Google Apps Script Web App (Recommended & Easiest)
# Deploy google-apps-script/Code.gs as a Web App and paste the URL below:
GOOGLE_APPS_SCRIPT_URL=
# Optional shared secret matching APPS_SCRIPT_SECRET in Code.gs:
GOOGLE_APPS_SCRIPT_SECRET=

# Option B: Google Sheets API v4 (Service Account)
# Spreadsheet ID from https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Bookings!A:M
# Either path to your service account JSON key file OR the raw JSON string:
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------
# Optional: Supabase Stores Table (Public Read for Active Stores)
# ------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
